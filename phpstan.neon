parameters:
    # Niveau 5 : bon compromis. Pour détecter plus d'erreurs (types nullables,
    # variables non définies, etc.), augmenter le niveau (max 10).
    level: 5
    paths:
        - cron
        - include
        - public
    excludePaths:
        analyseAndScan:
            - tests (?)
    scanFiles:
        - param-dist.php
    treatPhpDocTypesAsCertain: false
    # Constantes définies par param.php : leur valeur dépend de l'installation
    dynamicConstantNames:
        - APP_MODE_TEST
        - APP_MODE_DEBUG
        - SYLLABUS_LINK
    ignoreErrors:
        # param.php est propre à chaque installation (cf. param-dist.php)
        -
            identifier: require.fileNotFound
            path: include/fonctions.php
